# =============================================================================
# MediTrack Backend Environment Configuration
# =============================================================================

# Server Port (Render automatically sets PORT in production; defaults to 5000 locally)
PORT=5000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=production

# MongoDB Connection String:
# - Local Development: mongodb://127.0.0.1:27017/meditrack
# - MongoDB Atlas Cloud: mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/meditrack?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/meditrack?retryWrites=true&w=majority

# JWT Authentication Secret Key (Use a strong random string of at least 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# Allowed Frontend Domain(s) for CORS (Comma-separated for multiple origins)
# - Local Development: http://localhost:5173
# - Render Production: https://meditrack-frontend.onrender.com
CLIENT_URL=https://meditrack-frontend.onrender.com

# -----------------------------------------------------------------------------
# Initial Administrator Account (Used by `npm run seed:admin`)
# -----------------------------------------------------------------------------
ADMIN_NAME=MediTrack Administrator
ADMIN_EMAIL=admin@meditrack.com
ADMIN_PASSWORD=ChangeThisSecurePassword2026!
