# =============================================================================
# MediTrack - Full Project Environment Variables Reference
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BACKEND SERVICE (Add these to Render Web Service: meditrack-backend)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/meditrack?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
CLIENT_URL=https://meditrack-frontend.onrender.com
ADMIN_NAME=MediTrack Administrator
ADMIN_EMAIL=admin@meditrack.com
ADMIN_PASSWORD=ChangeThisSecurePassword2026!

# -----------------------------------------------------------------------------
# 2. FRONTEND SERVICE (Add these to Render Static Site: meditrack-frontend)
# -----------------------------------------------------------------------------
VITE_API_URL=https://meditrack-backend.onrender.com/api
